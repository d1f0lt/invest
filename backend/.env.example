# Read automatically by `docker compose` from a file named `.env` in this
# directory. Copy this file to `.env` and fill in JWT_SECRET before running
# `docker compose up` with the `users` or `gateway` services - both
# refuse to start without it (see JWT_SECRET:? in docker-compose.yml).

# Signs access tokens issued by the `users` service on login, and is what
# `gateway` verifies them with - the two MUST use the exact same value
# (docker-compose gives both services this same variable). `gateway` is
# the only service that checks the signature; every other backend
# service (price_reader, users, portfolio, parser) trusts the
# "x-user-id" gRPC metadata gateway sets after that check (was the
# X-User-ID HTTP header before internal services moved to gRPC on
# 2026-09-20), without a cryptographic check of its own - see
# architecture-decisions.md and gateway's/users'/portfolio's README for
# the full history of that decision.
#
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Passwords for the infrastructure containers. docker compose refuses to
# start without them (${VAR:?} in docker-compose.yml). Use URL-safe values
# (letters/digits only): the Postgres and RabbitMQ passwords are also
# inserted into connection URLs (DATABASE_URL, RABBITMQ_URL). Generate with:
#   openssl rand -hex 24
#
# POSTGRES_PASSWORD is applied only when the postgres_data volume is
# created for the first time. For an existing local volume keep the
# password it was created with (it used to be hardcoded as "postgres"),
# or recreate the volume: docker compose down -v (deletes all data!).
POSTGRES_PASSWORD=

# MinIO root user = the S3 access key gateway and parser use.
# MINIO_ROOT_PASSWORD must be at least 8 characters.
MINIO_ROOT_USER=invest
MINIO_ROOT_PASSWORD=

RABBITMQ_USER=invest
RABBITMQ_PASSWORD=
