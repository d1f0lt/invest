# AMQP connection string for RabbitMQ. In docker-compose this is
# overridden to point at the rabbitmq service (see root docker-compose.yml).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Durable queue the gateway service publishes parsing tasks to. See
# architecture-decisions.md ("parser: асинхронный разбор отчётов") and
# this service's README for the message shape.
RABBITMQ_QUEUE=report.uploaded

# MinIO (S3-compatible) connection. Endpoint is host:port, no scheme.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false

# gRPC address of the portfolio service, which receives the parsed
# trades. Renamed 2026-09-20 from PORTFOLIO_BASE_URL (which held an
# http:// URL) - gRPC dialing takes a bare host:port, no scheme; see
# internal/portfolioclient/client.go. The parser still identifies itself
# to portfolio by attaching the caller's user id directly (now as
# "x-user-id" gRPC metadata, was the X-User-ID HTTP header - no
# JWT_SECRET needed here, see internal/authmd and architecture-decisions.md).
PORTFOLIO_GRPC_ADDR=localhost:8083

# Address parser's own gRPC health server listens on. Renamed 2026-09-20
# from HTTP_ADDR: parser has no API of its own - the service's real work
# happens on the RabbitMQ consumer loop - this only serves the standard
# gRPC health check (grpc.health.v1.Health/Check) for Docker/operators.
GRPC_ADDR=:8084

# debug | info | warn | error
LOG_LEVEL=info
