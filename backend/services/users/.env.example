DATABASE_URL=postgres://postgres:postgres@localhost:5432/invest?sslmode=disable

GRPC_ADDR=:8082

JWT_SECRET=

ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# Background job deleting expired refresh_tokens rows: runs every
# REFRESH_TOKEN_CLEANUP_INTERVAL, keeps rows for
# REFRESH_TOKEN_CLEANUP_RETENTION past their expires_at (reuse detection
# still needs recently-dead tokens as evidence).
REFRESH_TOKEN_CLEANUP_INTERVAL=1h
REFRESH_TOKEN_CLEANUP_RETENTION=720h

BCRYPT_COST=12

LOG_LEVEL=info
