# Postgres connection string (same database price_updater writes to).
# In production, point this at a read-only role instead of the superuser.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invest?sslmode=disable

# Address the gRPC server listens on. Renamed 2026-09-20 from HTTP_ADDR:
# this service no longer speaks HTTP at all, see architecture-decisions.md,
# "перевод внутреннего взаимодействия сервисов на gRPC". The old
# HTTP_TIMEOUT variable is gone too - it configured the removed
# http.Server's Read/WriteTimeout, which has no gRPC equivalent worth
# keeping (see internal/config/config.go's doc comment).
GRPC_ADDR=:8081

# debug | info | warn | error
LOG_LEVEL=info

# MOEX ISS: 10-minute candles for the "day" chart and reference data for the
# asset card's "about" section are fetched on demand and cached in memory.
MOEX_ISS_BASE_URL=https://iss.moex.com/iss
MOEX_TIMEOUT=10s

# Dividend history (MOEX ISS no longer serves it): dohod.ru pages, parsed and
# cached for a day per security.
DIVIDENDS_BASE_URL=https://www.dohod.ru/ik/analytics/dividend
