# Postgres connection string (same "invest" database as the other services).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invest?sslmode=disable

# Address the gRPC server listens on. Renamed 2026-09-20 from HTTP_ADDR:
# this service no longer speaks HTTP at all, see architecture-decisions.md,
# "перевод внутреннего взаимодействия сервисов на gRPC".
GRPC_ADDR=:8083

# debug | info | warn | error
LOG_LEVEL=info

# No JWT_SECRET here: this service never verified a bearer token itself -
# it trusts the "x-user-id" gRPC metadata set by whatever reached it (was:
# the X-User-ID HTTP header). Safe only because this service has no
# published port (see root docker-compose.yml). See README.md and
# internal/authmd/authmd.go.
