# Postgres connection string (same "invest" database as the other services).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invest?sslmode=disable

# gRPC server address (no published port - only gateway calls it).
GRPC_ADDR=:8085

# debug | info | warn | error
LOG_LEVEL=info

# Token from @BotFather. Empty = alerts can be managed but nothing is sent,
# and POST /api/v1/telegram/link answers 422.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org

# How often alerts are compared with latest_prices.
CHECK_INTERVAL=1m
# Quotes older than this are ignored (price_updater stopped).
PRICE_STALE_AFTER=5m
# Lifetime of the one-time t.me/<bot>?start=<token> link.
LINK_TOKEN_TTL=15m
MAX_ALERTS_PER_USER=100
