# Address the HTTP server listens on. Unlike every other backend
# service, gateway's port IS meant to be published outside the
# docker-compose network - see root docker-compose.yml and
# architecture-decisions.md. Unchanged by the 2026-09-20 gRPC
# conversion: gateway's own external API is still plain HTTP/JSON, for
# the mobile client - only the calls it makes to users/portfolio/
# securities_reader became gRPC (see the three *_GRPC_ADDR variables below).
HTTP_ADDR=:8080

# Secret used to VERIFY access tokens issued by the users service
# (HMAC-SHA256). Required, at least 32 bytes, no default on purpose -
# this MUST be the exact same value as the users service's own
# JWT_SECRET (in docker-compose both come from the root .env file).
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# gRPC addresses of the three backend services gateway calls into.
# Renamed 2026-09-20 from USERS_BASE_URL/PORTFOLIO_BASE_URL/
# PRICE_READER_BASE_URL (which held http:// URLs, for the old
# httputil.ReverseProxy setup) - gRPC dialing takes a bare host:port, no
# scheme. See architecture-decisions.md, "перевод внутреннего
# взаимодействия сервисов на gRPC". In docker-compose these point at the
# service names on the compose network; the localhost defaults below are
# only useful when running gateway on the host against services also run
# with `go run` (see each service's README, "Запуск без Docker").
USERS_GRPC_ADDR=localhost:8082
PORTFOLIO_GRPC_ADDR=localhost:8083
SECURITIES_READER_GRPC_ADDR=localhost:8081

# How long gateway waits for a downstream gRPC call (a translated route,
# or the portfolio-ownership check before accepting a report upload) to
# respond.
UPSTREAM_TIMEOUT=15s

# RabbitMQ: where gateway publishes a "report.uploaded" task after
# saving an uploaded broker report to MinIO, for parser to pick up. See
# architecture-decisions.md ("parser: асинхронный разбор отчётов") и
# backend/services/parser/README.md for the consuming side.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=report.uploaded

# MinIO (S3-compatible) connection. Endpoint is host:port, no scheme.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false

# Bucket uploaded reports are written to. Must match the bucket the
# minio-init one-shot service creates (see root docker-compose.yml) and
# the one parser reads from.
REPORTS_BUCKET=reports

# Caps the size of an accepted report upload (bytes), so a careless or
# hostile client can't exhaust gateway memory or fill MinIO with one
# request.
MAX_UPLOAD_BYTES=33554432

# debug | info | warn | error
LOG_LEVEL=info
