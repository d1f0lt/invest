# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invest?sslmode=disable

# MOEX ISS API base URL (rarely needs changing)
MOEX_ISS_BASE_URL=https://iss.moex.com/iss

# Comma-separated MOEX board IDs to poll. TQBR is the main equities board
# (T+ settlement, ordinary & preferred shares). Add more boards (e.g. TQTF
# for exchange-traded funds) if you need them.
MOEX_BOARDS=TQBR,TQTF,TQOB,TQCB

# How often to poll MOEX for current prices (also feeds the live
# hourly/daily candles).
POLL_INTERVAL=1m

# Nightly job (Europe/Moscow time, HH:MM): loads MOEX's official daily
# candles for every day since the last loaded one and drops hourly
# candles older than each security's last trading day. Also runs once
# at startup.
HISTORY_RUN_AT=03:00

# How many days of daily candles to backfill for a board that has never
# been synced (first start). Larger = deeper "all time" chart, longer
# first-start backfill.
BACKFILL_DAYS=365

# Pause between dates while backfilling history, to go easy on MOEX.
HISTORY_REQUEST_PAUSE=200ms

# Timeout for a single HTTP request to MOEX.
HTTP_TIMEOUT=15s

# debug | info | warn | error
LOG_LEVEL=info
